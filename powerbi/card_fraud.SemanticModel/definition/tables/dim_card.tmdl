table dim_card
	lineageTag: dim_card

	column card_id
		dataType: string
		lineageTag: ebcad8aa-cc72-4bef-afa2-edd71b339856
		summarizeBy: none
		sourceColumn: card_id

	column first_seen_at
		dataType: dateTime
		lineageTag: 2c51f5a1-a47c-4967-acbd-7fb872b1606a
		summarizeBy: none
		sourceColumn: first_seen_at

	column transaction_count
		dataType: int64
		lineageTag: 0a18c7ea-de89-412a-957d-3d6f9ce595cc
		summarizeBy: none
		sourceColumn: transaction_count

	partition dim_card = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(GoldFolder & "\dim_card.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"card_id", type text}, {"first_seen_at", type datetime}, {"transaction_count", Int64.Type}}, "en-US")
				in
				    Typed

